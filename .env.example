# Copy this file to .env.local and fill in the values.
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_ and never commit it.
# Used to add people, reset passwords, read the email list and write the email log.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# The address people open the app at. Used in sign-in links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email after each Sunday is saved, sent with Nodemailer through a mailbox you control.
# Gmail: host smtp.gmail.com, port 465, user = the full Gmail address, pass = a 16-character app password.
# Leave SMTP_HOST blank to turn email off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=rehoboth.headcount@gmail.com
SMTP_PASS=
EMAIL_FROM="Sunday Headcount <rehoboth.headcount@gmail.com>"

# Monthly backup email (netlify/functions/monthly-backup.ts): on the 1st of each month the
# "Export all data" .zip is emailed here. Several addresses: separate with commas. Leave blank to turn it off.
# It only runs on the live Netlify site, not with npm run dev.
BACKUP_EMAIL=
